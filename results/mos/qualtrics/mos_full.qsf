      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "\n<h3>Set your volume</h3>\n<p>Before you start, set a comfortable listening level and then leave it there for the\nrest of the session.</p>\n<p>The clip below is the <b>loudest</b> in the study. Some of the audio you will hear is\nmachine-generated and can sound harsh or distorted. Set your volume so that <b>this</b>\nclip is comfortable &mdash; everything else will then be at or below that level.</p>\n<audio controls preload=\"none\" style=\"width:100%\"><source src=\"https://qualtrics.ucl.ac.uk/CP/File.php?F=F_ILl5fa7NtGYerlk\" type=\"audio/mpeg\"></audio>\n<p>Use headphones, in a quiet place. If any clip is uncomfortable, every trial has a\n<b>Skip</b> option.</p>\n",
        "QuestionType": "DB",
        "Selector": "TB",
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "QuestionID": "QID5",
        "DataExportTag": "CALIBRATION",
        "QuestionDescription": "Volume calibration",
        "DataVisibility": {
          "Private": false,
          "Hidden": false
        },
        "Configuration": {
          "QuestionDescriptionOption": "UseText"
        },
        "GradingData": [],
