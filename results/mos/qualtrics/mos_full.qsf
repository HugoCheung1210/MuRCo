      "SecondaryAttribute": "Break",
      "TertiaryAttribute": null,
      "Payload": {
        "QuestionText": "\n<h3>End of part 1 &mdash; take a break</h3>\n<p>That is the rating task finished. Thank you.</p>\n<p><b>Part 2 is shorter</b>: 24 comparisons, about 12 minutes.</p>\n<p>Take as long as you like before continuing &mdash; this page will wait. Stretch, rest\nyour ears, and carry on when you are ready. You can still stop at any point before\nsubmitting.</p>\n",
        "QuestionType": "DB",
        "Selector": "TB",
        "Validation": {
          "Settings": {
            "Type": "None"
          }
        },
        "QuestionID": "QID15",
        "DataExportTag": "BREAK",
        "QuestionDescription": "Break",
        "DataVisibility": {
